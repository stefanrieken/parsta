# Variable number of args is supported for '+'
printnum (+ 1 2 3 4);

# And for '*'
printnum (* 2 3 4);

# This is half of 42:
printnum (if 1 { * (+ 1 2) (+ 3 4) });

# And this is all of it:
if 1 { printnum (+ (* 3 4) (* 5 6)) };

# General flexing:
define "greet" {
    args "who";

    if 1 {
        print "Hello, ";
        print who;
        print "!\n";
    }
};

greet "world";

define "x" 40;

loop {
    if (< x 43) {
    printnum x;
        set "x" (+ x 1);
        return 1
    }
}
